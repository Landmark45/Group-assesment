# Copy this file to `.env` and adjust as needed.

# Port the API listens on. 4100 rather than the more common 4000, which is often
# already taken on a development machine.
PORT=4100

# Where MongoDB lives. A local install uses the value below as-is;
# MongoDB Atlas gives you a mongodb+srv://... string instead.
#
# The database name is deliberately specific ("educonnect_platform" rather than
# just "educonnect") so that running the seed script cannot wipe an unrelated
# database that happens to share a shorter name.
MONGODB_CONNECTION_URI=mongodb://127.0.0.1:27017/educonnect_platform

# Secret used to sign JSON Web Tokens. Use a long random string in production.
JSON_WEB_TOKEN_SECRET=replace-this-with-a-long-random-secret-value
JSON_WEB_TOKEN_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_CLIENT_ORIGINS=http://localhost:5173
